rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Default Catch-All Deny Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- REUSABLE SECURITY UTILITIES ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- STANDALONE MODEL VALIDATION GATES ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'favorPoints']) &&
             data.keys().size() == 2 &&
             data.uid is string && data.uid.size() <= 128 && data.uid == request.auth.uid &&
             data.favorPoints is int;
    }

    function isValidTask(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'date', 'time', 'duration', 'isLocked', 'completed']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.title is string && data.title.size() <= 200 &&
             data.date is string && data.date.size() <= 32 &&
             data.time is string && data.time.size() <= 32 &&
             data.duration is string && data.duration.size() <= 32 &&
             data.isLocked is bool &&
             data.completed is bool;
    }

    function isValidRoutine(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'tasks']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.name is string && data.name.size() <= 100 &&
             data.tasks is list && data.tasks.size() <= 50;
    }

    function isValidTransfer(data) {
      return data.keys().hasAll(['id', 'fromUserId', 'toUserId', 'taskData', 'compensation', 'status', 'createdAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.fromUserId is string && data.fromUserId.size() <= 128 &&
             data.toUserId is string && data.toUserId.size() <= 128 &&
             data.status is string && data.status.size() <= 32 &&
             data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidNote(data) {
      return data.keys().hasAll(['id', 'userId', 'rawText', 'createdAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.rawText is string && data.rawText.size() <= 20000 &&
             data.createdAt is int;
    }

    // --- PATH-SPECIFIC RULE MATCHES ---

    // 1. Users Profiles
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isVerifiedUser() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isVerifiedUser() && request.auth.uid == userId && isValidUser(incoming()) && incoming().uid == existing().uid;
      allow delete: if isVerifiedUser() && request.auth.uid == userId;
    }

    // 2. Schedule Tasks
    match /tasks/{taskId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isVerifiedUser() && isValidTask(incoming()) && isValidId(taskId);
      allow update: if isVerifiedUser() && isValidTask(incoming()) && isValidId(taskId) && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid && isValidId(taskId);
    }

    // 3. User Routines
    match /routines/{routineId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isVerifiedUser() && isValidRoutine(incoming()) && isValidId(routineId);
      allow update: if isVerifiedUser() && isValidRoutine(incoming()) && isValidId(routineId) && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid && isValidId(routineId);
    }

    // 4. Peer-to-Peer Transfers
    match /transfers/{transferId} {
      allow get: if isSignedIn() && (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid);
      allow list: if isSignedIn() && (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid);
      allow create: if isVerifiedUser() && isValidTransfer(incoming()) && incoming().fromUserId == request.auth.uid && isValidId(transferId);
      allow update: if isVerifiedUser() && isValidTransfer(incoming()) && (existing().fromUserId == request.auth.uid || existing().toUserId == request.auth.uid) && incoming().id == existing().id && incoming().fromUserId == existing().fromUserId && incoming().toUserId == existing().toUserId && isValidId(transferId);
      allow delete: if isVerifiedUser() && existing().fromUserId == request.auth.uid && isValidId(transferId);
    }

    // 5. General Notes Repository
    match /notes/{noteId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isVerifiedUser() && isValidNote(incoming()) && isValidId(noteId);
      allow update: if isVerifiedUser() && isValidNote(incoming()) && isValidId(noteId) && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid && isValidId(noteId);
    }
  }
}
